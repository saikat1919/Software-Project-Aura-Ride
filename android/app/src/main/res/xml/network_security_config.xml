<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG/DEMO build: allow cleartext HTTP everywhere so the app can reach the backend over
  a LAN IP (http://192.168.x.x:8000) or adb reverse (http://localhost:8000) without editing
  this file per network. A production build would remove this and use HTTPS only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
