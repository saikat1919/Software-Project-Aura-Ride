# Aura Ride backend — environment template.
# Copy to `.env` and fill in real values:  cp .env.example .env
# The real .env is gitignored (it holds secrets). Nothing here is secret.

# ---- Core Django ----
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
# Comma-separated. Add your PC's LAN IP so a physical phone can reach the server.
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,192.168.0.106

# ---- Auth ----
# Access-token lifetime in hours (12 = comfortable for a demo; production uses less).
ACCESS_TOKEN_HOURS=12

# ---- AI checks ----
# 1 = fake canned face-match/gender (fast, no models). 0 = real DeepFace (downloads weights).
DEMO_FAKE_AI=0
# 1 = skip biometric signature verification (DEV ONLY; forced off unless DEBUG=1).
DEMO_FAKE_AUTH=0

# ---- Routing / geo ----
# 1 = haversine estimate (no OSRM server). 0 = real OSRM at OSRM_BASE_URL.
DEMO_FAKE_ROUTING=1
OSRM_BASE_URL=https://router.project-osrm.org

# ---- Matching / ride rules ----
MATCH_RADIUS_KM=50            # wide for a co-located demo; ~5 in production
OFFER_TIMEOUT_SECONDS=90      # per-driver accept window (room for a real fingerprint tap)
GEOFENCE_METERS=300           # how close the driver must be to the pickup to "arrive"
ENFORCE_GEOFENCE=0            # 1 = also require driver at the dropoff to complete

# ---- Database (optional) ----
# Leave DB_ENGINE unset to use the default sqlite file (no server needed).
# Set DB_ENGINE=postgres to use PostgreSQL with the settings below.
# DB_ENGINE=postgres
# DB_NAME=aura
# DB_USER=aura
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432
